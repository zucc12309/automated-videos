# Copy to .env (never commit it) or export in the shell that launches run-server.sh.
# Claude creative direction (CLAUDE / HYBRID modes). A Claude.ai subscription is not an API key.
ANTHROPIC_API_KEY=
# Optional: pin a different Anthropic endpoint for unattended jobs (defaults to https://api.anthropic.com).
VIDEO_MCP_ANTHROPIC_BASE_URL=
# Higgsfield official SDK (pip install higgsfield-client). Either HF_KEY, or HF_API_KEY + HF_API_SECRET.
HF_KEY=
HF_API_KEY=
HF_API_SECRET=
# Optional: Chromium/headless-shell binary for Remotion (otherwise Remotion's own browser is used).
REMOTION_BROWSER_EXECUTABLE=
